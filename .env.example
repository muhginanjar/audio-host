# ── App ──────────────────────────────────────────────────────────────
# Public base URL — used to build /a/{id}, /embed/{id} and API docs.
APP_URL=https://audio.example.com
APP_ENV=production
PORT=3000
HOST=0.0.0.0

# ── Database (SQLite; zero-ops single file) ─────────────────────────
DB_SQLITE_PATH=data/audio.sqlite

# ── Storage ──────────────────────────────────────────────────────────
# local | (s3/r2/wasabi drivers plug into src/server/storage in Phase 3)
STORAGE_DRIVER=local
STORAGE_ROOT=storage

# ── Limits (defaults; admin can override at runtime in System Settings) ──
MAX_UPLOAD_SIZE_MB=100
API_RATE_LIMIT=100
UPLOAD_RATE_LIMIT=10
USER_STORAGE_LIMIT_MB=1024
SESSION_TTL_DAYS=14

# ── Security ─────────────────────────────────────────────────────────
# Comma-separated exact origins for CORS on /api/v1. EMPTY = same-origin only.
# NEVER set * unless you truly mean any site may call the API.
CORS_ALLOWED_ORIGINS=
# Force secure cookies behind TLS (auto-enabled when APP_URL starts with https)
COOKIE_SECURE=
