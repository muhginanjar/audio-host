{
  "name": "audio-host",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Audio Hosting & Delivery Platform — upload, store, manage, and distribute audio via Web GUI + REST API",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "migrate": "tsx src/server/db/migrate-cli.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.4",
    "file-type": "^21.0.0",
    "hono": "^4.9.10",
    "music-metadata": "^11.9.1",
    "ulid": "^3.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-router": "^1.131.10",
    "@tanstack/router-plugin": "^1.131.10",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.6"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
